# Copy into Streamlit Cloud → App settings → Secrets
# Do NOT commit real values. After paste: Save → Manage app → Reboot.

# REQUIRED for public deal/Stripe/SMS links (NO trailing slash).
# Do NOT use http://localhost:8501 — outsiders cannot open that.
APP_BASE_URL = "https://realestateshark.streamlit.app"

RENTCAST_API_KEY = "paste_rentcast_key"

# --- Twilio SMS (TOP-LEVEL keys — required for Go-Live Check = ON) ---
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "paste_twilio_auth_token"
TWILIO_PHONE_NUMBER = "+1XXXXXXXXXX"
# Your real cell (E.164) — rings first on War Room Click to Call.
TWILIO_AGENT_PHONE = "+1XXXXXXXXXX"
NOTIFY_PHONE = "+1XXXXXXXXXX"
# Twilio Function / conference webhook (Voice URL on your Twilio number)
# TWILIO_VOICE_WEBHOOK = "https://your-function.twil.io/conference"

GOOGLE_MAPS_API_KEY = ""
SKIP_TRACE_API_URL = ""
SKIP_TRACE_API_KEY = ""
# Owner name: RENTCAST_API_KEY. Cell phones: people-data vendor below (optional).
# PEOPLE_DATA_API_URL = "https://api.vendor.com/lookup?name={name}&address={address}&api_key={api_key}"
PEOPLE_DATA_API_URL = ""
PEOPLE_DATA_API_KEY = ""

# --- Stripe EMD ($20 = 2000 cents) ---
# PRODUCTION: sk_live_... (or rk_live_...). sk_test_ = demo charges only.
STRIPE_SECRET_KEY = "sk_live_xxxxxxxx"
STRIPE_EMD_CENTS = "2000"

# --- Buyer email blast (Gmail App Password — not your normal password) ---
EMAIL_USER = "you@gmail.com"
EMAIL_PASS = "xxxx_gmail_app_password_xxxx"
EMAIL_FROM = "deals@yourdomain.com"
BUYER_EMAILS = "buyer1@example.com, buyer2@example.com"

# --- Escrow / wire on PDF ---
WIRE_BANK = "Your Title Company Escrow"
WIRE_ACCOUNT = "xxxx"
WIRE_ROUTING = "xxxx"
TITLE_COMPANY_NAME = "ABC Title / Escrow"

# --- Google Sheets vault (BOTH URL block + SA required for Command Center ON) ---
# 1) Create sheet → rename a tab to exactly: Leads
# 2) GCP → IAM → Service Accounts → Create key (JSON)
# 3) Paste JSON fields into [gcp_service_account] below
# 4) Share the sheet with client_email (Editor)
GOOGLE_SHEETS_URL = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# Uncomment and paste full Google Cloud service-account JSON fields:
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
