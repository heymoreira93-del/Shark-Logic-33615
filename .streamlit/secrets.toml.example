# Copy into Streamlit Cloud → App settings → Secrets
# Do NOT commit real values.

RENTCAST_API_KEY = "your_rentcast_key"
# --- Twilio SMS (TOP-LEVEL keys — required for Go-Live Check = ON) ---
TWILIO_ACCOUNT_SID = "ACxxxxxxxx"
TWILIO_AUTH_TOKEN = "your_auth_token"
TWILIO_PHONE_NUMBER = "+18881234567"
NOTIFY_PHONE = "+1xxxxxxxxxx"
APP_BASE_URL = "https://realestateshark.streamlit.app"
GOOGLE_MAPS_API_KEY = ""
SKIP_TRACE_API_URL = ""
SKIP_TRACE_API_KEY = ""
# Owner name: RENTCAST_API_KEY. Cell phones: people-data vendor below.
PEOPLE_DATA_API_URL = ""
PEOPLE_DATA_API_KEY = ""
# Example: https://api.example.com/skip?name={name}&address={address}&api_key={api_key}

# --- Stripe EMD ($2,500 = 250000 cents) ---
STRIPE_SECRET_KEY = "sk_test_..."
STRIPE_EMD_CENTS = "250000"

# --- Buyer email blast (Gmail App Password) ---
EMAIL_USER = "you@gmail.com"
EMAIL_PASS = "your_gmail_app_password"
EMAIL_FROM = "you@mltxstudio.com"
BUYER_EMAILS = "buyer1@example.com, buyer2@example.com"

# --- Escrow / wire on PDF ---
WIRE_BANK = "Your Title Company Escrow"
WIRE_ACCOUNT = "xxxx"
WIRE_ROUTING = "xxxx"
TITLE_COMPANY_NAME = "ABC Title / Escrow"

# --- Google Sheets vault ---
GOOGLE_SHEETS_URL = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# st-gsheets-connection (share sheet with the service account email)
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# Paste full service account JSON fields here (from Google Cloud):
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
