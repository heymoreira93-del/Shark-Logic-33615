# Copy to .env and fill real values. Never commit .env.
# Public Streamlit URL (no trailing slash). Not localhost — links must work for outsiders.
APP_BASE_URL=https://realestateshark.streamlit.app

RENTCAST_API_KEY=your_key_here
GOOGLE_MAPS_API_KEY=

TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=+18881234567
TWILIO_AGENT_PHONE=
NOTIFY_PHONE=+15551234567
# TWILIO_VOICE_WEBHOOK=https://your-function.twil.io/conference

# Stripe EMD — sk_live_... for production money; sk_test_ for demo only
STRIPE_SECRET_KEY=
# Optional. Hosted Checkout does not need this. pk_live_ / pk_test_ only.
# STRIPE_PUBLISHABLE_KEY=
# Optional. Streamlit Cloud cannot receive webhooks; payment is verified by session retrieve.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Assignment EMD in dollars (preferred). $2,500 default.
STRIPE_EMD_DOLLARS=2500
# Or cents: STRIPE_EMD_CENTS=250000  (if you type 2500 here it is treated as dollars)

# Buyer email blast (Gmail 2FA App Password — not your normal password)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
BUYER_EMAILS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Google Sheets vault (also use .streamlit/secrets.toml [connections.gsheets] + gcp_service_account)
GOOGLE_SHEETS_URL=

SKIP_TRACE_API_URL=
SKIP_TRACE_API_KEY=

# Optional cell phones (not RentCast):
# PEOPLE_DATA_API_URL=https://api.vendor.com/lookup?name={name}&address={address}&api_key={api_key}
PEOPLE_DATA_API_URL=
PEOPLE_DATA_API_KEY=

WIRE_BANK=
WIRE_ACCOUNT=
WIRE_ROUTING=
TITLE_COMPANY_NAME=
TITLE_COMPANY_EMAIL=
# Name stamped on assignment PDF as Assignor (defaults to DealShark Acquisitions)
ASSIGNOR_SIGNATORY=DealShark Acquisitions
